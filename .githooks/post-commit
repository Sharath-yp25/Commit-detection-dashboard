#!/bin/bash

REGION="ap-south-1"
LOG_GROUP="//git/commits"
LOG_STREAM="Project-login"

# Collect commit data
BRANCH=$(git rev-parse --abbrev-ref HEAD)
AUTHOR=$(git log -1 --format="%an")
HASH=$(git log -1 --format="%h")
MSG=$(git log -1 --format="%s")
TS_ISO=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
TS_MS=$(date +%s%3N)

# Create JSON payload
PAYLOAD=$(python -c "
import json
print(json.dumps({
    'timestamp': '$TS_ISO',
    'branch': '$BRANCH',
    'author': '$AUTHOR',
    'hash': '$HASH',
    'message': '$MSG',
    'project': 'login'
}))
")

# Save locally
echo "$PAYLOAD" >> commit_logs.json
echo "[hook] Logged locally: $HASH"

# Create CloudWatch log event
LOG_EVENT=$(python -c "
import json
print(json.dumps([
    {
        'timestamp': $TS_MS,
        'message': '''$PAYLOAD'''
    }
]))
")

# Send to CloudWatch
MSYS_NO_PATHCONV=1 aws logs put-log-events \
  --region "$REGION" \
  --log-group-name "$LOG_GROUP" \
  --log-stream-name "$LOG_STREAM" \
  --log-events "$LOG_EVENT"

if [ $? -eq 0 ]; then
    echo "[hook] Shipped to CloudWatch: $HASH"
else
    echo "[hook] Failed to ship to CloudWatch"
fi